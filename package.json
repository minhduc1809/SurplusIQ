{
  "name": "surplusiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f",
    "build": "npm run build:core && npm --workspace=@surplusiq/backend run build && npm --workspace=@surplusiq/web run build && npm --workspace=@surplusiq/simulation run build",
    "build:core": "npm --workspace=@surplusiq/core run build",
    "migration:run": "npm --workspace=@surplusiq/backend run migration:run",
    "migration:revert": "npm --workspace=@surplusiq/backend run migration:revert",
    "seed": "npm --workspace=@surplusiq/backend run seed",
    "dev:backend": "npm --workspace=@surplusiq/backend run start:dev",
    "dev:web": "npm --workspace=@surplusiq/web run dev",
    "dev:simulation": "npm --workspace=@surplusiq/simulation run start",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:core && npm --workspace=@surplusiq/core run test && npm --workspace=@surplusiq/backend run test",
    "test:core": "npm --workspace=@surplusiq/core run test",
    "test:backend": "npm --workspace=@surplusiq/backend run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  }
}
