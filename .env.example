# ==============================================================================
# SURPLUSIQ PLATFORM - COMPREHENSIVE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Sao chép file này thành .env trước khi khởi chạy hệ thống:
#   cp .env.example .env
# Lưu ý: Tuyệt đối không commit file .env chứa thông tin bí mật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ỨNG DỤNG & MÁY CHỦ (SERVER & APPLICATION)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME="SurplusIQ Engine API"
APP_VERSION=1.0.0

# CORS Whitelist (phân cách bằng dấu phẩy, dùng cho Web Admin & Mobile App)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4000

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL & POSTGIS (DATABASE)
# ------------------------------------------------------------------------------
DB_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=surplus_admin
POSTGRES_PASSWORD=surplus_secret_pass
POSTGRES_DB=surplusiq_db

# Chuỗi kết nối TypeORM / Prisma / Drizzle
DATABASE_URL=postgresql://surplus_admin:surplus_secret_pass@localhost:5432/surplusiq_db

# Tự động chạy Migration khi khởi động (Môi trường Dev có thể bật false, chạy tay qua npm run migration:run)
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# 3. BỘ ĐỆM REDIS & HÀNG ĐỢI BULLMQ (CACHE & QUEUES)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Cấu hình BullMQ Queue Worker
BULLMQ_CONCURRENCY=5
BULLMQ_PREFIX=surplusiq_queue

# ------------------------------------------------------------------------------
# 4. XÁC THỰC, PHÂN QUYỀN & BẢO MẬT (AUTH, JWT & SECURITY)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT Access Token (bắt buộc tối thiểu 32 ký tự ngẫu nhiên trong production)
JWT_SECRET=surplusiq_super_secret_jwt_key_2026_production_grade_random_seed_32chars

# Thời hạn token
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Cấu hình mã OTP (Đăng ký, Đăng nhập, Quên mật khẩu)
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_MAX_RESENDS_PER_HOUR=3

# Thiết bị tin cậy & Đổi mật khẩu
TRUSTED_DEVICE_DAYS=30
PASSWORD_MIN_LENGTH=8
BACKUP_CODE_SALT=surplusiq_backup_code_salt_secure_2026_random

# ------------------------------------------------------------------------------
# 5. MÃ QR NHẬN HÀNG AN TOÀN (QR TOKEN HMAC-SHA256 & BACKUP PIN)
# ------------------------------------------------------------------------------
# Khóa bí mật HMAC ký QR Token không chứa PII (Chuẩn BR-022, 9.1 - tối thiểu 32 ký tự)
QR_HMAC_SECRET=surplusiq_qr_hmac_secret_key_32chars_long_min_security_hash
QR_TOKEN_TTL_MINUTES=60
PROXY_PICKUP_CODE_LENGTH=6

# ------------------------------------------------------------------------------
# 6. TÍCH HỢP TRÍ TUỆ NHÂN TẠO GEMINI (AI ENGINE)
# ------------------------------------------------------------------------------
# Google Gemini AI Studio API Key (dùng cho hỗ trợ phân tích, viết mô tả, tóm tắt)
# Lõi định giá sàn, dự báo thống kê và giữ suất hoạt động độc lập ngay cả khi thiếu API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 7. CỔNG THANH TOÁN & ĐỐI SOÁT VIETQR (PAYMENTS & SETTLEMENT)
# ------------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=surplusiq_payment_webhook_secret_key_2026_sha256
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME="CONG TY CP SURPLUSIQ VIET NAM"
VIETQR_TEMPLATE=compact2

# ------------------------------------------------------------------------------
# 8. LIÊN KẾT ĐIỀU HƯỚNG & FRONTEND (FRONTEND & DEEP LINKS)
# ------------------------------------------------------------------------------
# URL Dashboard Quản trị & Chủ cửa hàng
WEB_STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# Mobile App Deep Link Scheme (Android Kotlin app)
APP_DEEP_LINK_SCHEME=surplusiq
APP_DOWNLOAD_URL=https://surplusiq.vn/download

# ------------------------------------------------------------------------------
# 9. CHÍNH SÁCH LƯU TRỮ & DỌN DẸP DỮ LIỆU (DATA RETENTION POLICIES)
# ------------------------------------------------------------------------------
# Thời gian lưu trữ nhật ký kiểm toán (Audit Logs) - tối thiểu 12 tháng
RETENTION_AUDIT_MONTHS=12

# Thời gian lưu trữ thông báo người dùng (ngày)
RETENTION_NOTIFICATIONS_DAYS=90

# Thời gian lưu trữ hội thoại & log AI (ngày)
RETENTION_AI_LOGS_DAYS=90

# Thời gian lưu trữ lịch sử xem món ăn của khách (ngày)
RETENTION_VIEW_HISTORY_DAYS=30

# Thời gian lưu trữ Idempotency Key chống trùng lặp (ngày)
RETENTION_IDEMPOTENCY_DAYS=7

# ------------------------------------------------------------------------------
# 10. THÔNG BÁO PUSH & TIN NHẮN SMS (NOTIFICATIONS & SMS)
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=surplusiq-fcm
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""

# Dịch vụ gửi tin nhắn OTP (mock | esms | speedisms | twilio)
SMS_PROVIDER=mock
SMS_API_KEY=""

# ------------------------------------------------------------------------------
# 11. LƯU TRỮ TỆP TIN & HÌNH ẢNH (FILE STORAGE)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=5
