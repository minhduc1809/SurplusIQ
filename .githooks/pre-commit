#!/bin/sh
# SurplusIQ Git Pre-Commit Hook (rule.md)
# Ngăn chặn commit trực tiếp lên nhánh main / master

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Cho phép bỏ qua khi biến môi trường ALLOW_MAIN_COMMIT=1
if [ "$ALLOW_MAIN_COMMIT" = "1" ]; then
  exit 0
fi

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "======================================================================"
  echo "❌ [GIT HOOK LỖI] KHÔNG ĐƯỢC PHÉP COMMIT TRỰC TIẾP LÊN NHÁNH $branch!"
  echo "======================================================================"
  echo "Theo quy chuẩn rule.md của SurplusIQ:"
  echo "1. Nhánh $branch là nhánh nguồn sự thật (Single Source of Truth), chỉ nhận PR/Merge."
  echo "2. Bạn bắt buộc phải tạo nhánh chức năng trước khi commit code:"
  echo ""
  echo "   git checkout -b feature/<scope>-<ten-chuc-nang>"
  echo "   # hoặc"
  echo "   git checkout -b fix/<scope>-<ten-loi>"
  echo "   git checkout -b docs/<ten-tai-lieu>"
  echo ""
  echo "Sau đó thực hiện commit trên nhánh chức năng đó."
  echo "======================================================================"
  echo ""
  exit 1
fi

exit 0
