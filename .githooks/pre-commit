#!/bin/sh
# SurplusIQ Git Pre-Commit Hook (rule.md)
# Ngăn chặn commit trực tiếp lên nhánh main / development

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Cho phép bỏ qua khi biến môi trường ALLOW_PROTECTED_COMMIT=1
if [ "$ALLOW_PROTECTED_COMMIT" = "1" ] || [ "$ALLOW_MAIN_COMMIT" = "1" ]; then
  exit 0
fi

# Cho phép merge commit
if [ -f .git/MERGE_HEAD ] || [ -f "$(git rev-parse --git-dir 2>/dev/null)/MERGE_HEAD" ]; then
  exit 0
fi

if [ "$branch" = "main" ] || [ "$branch" = "master" ] || [ "$branch" = "development" ] || [ "$branch" = "develop" ]; then
  echo ""
  echo "======================================================================"
  echo "❌ [GIT HOOK LỖI] KHÔNG ĐƯỢC PHÉP COMMIT TRỰC TIẾP LÊN NHÁNH $branch!"
  echo "======================================================================"
  echo "Theo quy chuẩn rule.md của SurplusIQ:"
  echo "1. Nhánh $branch là nhánh được bảo vệ, chỉ nhận Merge / PR từ nhánh chức năng."
  echo "2. Bạn bắt buộc phải tạo nhánh chức năng trước khi commit code:"
  echo ""
  echo "   git checkout -b feature/<scope>-<ten-chuc-nang>"
  echo "   # hoặc"
  echo "   git checkout -b fix/<scope>-<ten-loi>"
  echo "   git checkout -b docs/<ten-tai-lieu>"
  echo ""
  echo "Sau đó thực hiện commit trên nhánh chức năng và merge vào development."
  echo "======================================================================"
  echo ""
  exit 1
fi

echo ""
echo "🚀 [PRE-COMMIT] Đang tự động format (Prettier) và sửa lỗi lint (ESLint) trên các file staged..."
npx lint-staged
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo "❌ [PRE-COMMIT] Lỗi Lint / Format! Vui lòng sửa các lỗi trên trước khi commit."
  echo "======================================================================"
  echo ""
  exit 1
fi

exit 0
